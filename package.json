{
  "name": "creditdesk-banking-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-data.mjs",
    "dev": "node scripts/dev.mjs",
    "engine": "node server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -b",
    "test:live": "node --test --test-concurrency=1 --test-timeout=600000 tests/live/*.test.ts",
    "test:browser": "vite build --logLevel warn && node --test --test-concurrency=1 --test-timeout=400000 tests/browser/*.test.ts",
    "screenshots": "vite build --logLevel warn && node scripts/screenshots.ts"
  },
  "dependencies": {
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
